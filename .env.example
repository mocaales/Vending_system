# Vzorec okolja. Kopiraj v .env (ni v gitu) in izpolni prazne vrednosti.
# Skrivnosti ustvari `openssl rand -hex 32`. Compose vsakemu zabojniku poda samo njegove spremenljivke.
# Povezave do baz (DATABASE_URL, SPRING_DATASOURCE_*) sestavi Compose iz gesel spodaj;
# naslovi storitev (MACHINE_URL, ...) so v docker-compose.yml.

# Gesla baz: šest zabojnikov postgres:17-alpine, vsak z lastno bazo in uporabnikom
MACHINE_DB_PASSWORD=
MONITORING_DB_PASSWORD=
PRODUCT_DB_PASSWORD=
INVENTORY_DB_PASSWORD=
SALES_DB_PASSWORD=
GATEWAY_DB_PASSWORD=

# Gateway: podpis žetonov operaterja (vsaj 32 znakov) in njihova veljavnost
JWT_SECRET=
JWT_TTL_MINUTES=480

# Prvi operater (gateway ga ustvari ob zagonu, samo če še ni nobenega računa)
BOOTSTRAP_OPERATOR_EMAIL=operater@vending.local
BOOTSTRAP_OPERATOR_PASSWORD=

# Gateway: izvori Web UI, ločeni z vejico; '*' ni dovoljen
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Notranji žetoni (X-Service-Token): po en za vsako storitev
GATEWAY_SERVICE_TOKEN=
MACHINE_SERVICE_TOKEN=
MONITORING_SERVICE_TOKEN=
PRODUCT_SERVICE_TOKEN=
INVENTORY_SERVICE_TOKEN=
SALES_SERVICE_TOKEN=

# E-pošta alarmov (lokalno Mailpit, http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=alarmi@vending.local
ALERT_EMAIL_TO=operater@vending.local

# Web UI (Vite, ob gradnji): vrednost je vidna v brskalniku, brez skrivnosti
VITE_API_URL=http://localhost:8080

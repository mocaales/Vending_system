# Vzorec okolja. Kopiraj v .env (ni v gitu) in izpolni prazne vrednosti.
# Vrednosti Supabase izpiše `supabase status`. Žeton ustvari `openssl rand -hex 32`.
# host.docker.internal velja v zabojnikih, 127.0.0.1 in localhost na računalniku in v brskalniku.
# Compose vsakemu zabojniku poda samo njegove spremenljivke.

# Supabase za skripte v backend/ na računalniku
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_SERVICE_ROLE_KEY=

# Gateway: javni ključi za preverjanje JWT operaterja
SUPABASE_JWKS_URL=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json

# Web UI (Vite): vrednosti so vidne v brskalniku, brez skrivnosti
VITE_API_URL=http://localhost:8080
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Baze storitev: ena vloga na shemo (backend/bootstrap.sql)
MACHINE_DATABASE_URL=postgresql+psycopg://machine_service:change-me@host.docker.internal:54322/postgres
MONITORING_DATABASE_URL=postgresql+psycopg://monitoring_service:change-me@host.docker.internal:54322/postgres
PRODUCT_DATABASE_URL=postgresql+psycopg://product_service:change-me@host.docker.internal:54322/postgres
INVENTORY_DATABASE_URL=postgresql+psycopg://inventory_service:change-me@host.docker.internal:54322/postgres
SALES_DATABASE_URL=postgresql+psycopg://sales_service:change-me@host.docker.internal:54322/postgres

# Notranji žetoni (X-Service-Token): po en za vsako storitev, ki kliče druge
GATEWAY_SERVICE_TOKEN=
SALES_SERVICE_TOKEN=
INVENTORY_SERVICE_TOKEN=
MONITORING_SERVICE_TOKEN=

# E-pošta alarmov (lokalno Mailpit, http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=alarmi@vending.local
ALERT_EMAIL_TO=operater@vending.local
